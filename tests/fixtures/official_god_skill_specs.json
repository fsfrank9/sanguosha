            "condition": "技能有效；伤害实际发生",
            "cost": "无额外消耗",
            "effect": "开局获得2暴怒；实际造成和受到的伤害按点分别增加暴怒。",
            "frequency": "锁定，每个满足条件的事件",
            "engineHooks": [
              "onDamageAfter",
              "onDamageDealt",
              "afterInitialHands"
            ],
            "boundaries": [
              "开局初始化在发牌后真正游戏开始时；与七星时机分开。",
              "同一次自己对自己伤害分别满足造成和受到，两边都计。",
              "防止伤害/失体力不增加；多目标与连环按实际各次伤害。"
            ]
          }
        },
        {
          "localSkillId": "wumou",
          "name": "无谋",
          "implementationStatus": "implemented",
          "sourceLine": "card__hero__legend.md:63",
          "sourceTextSha256": "354b67c50034e51537e90db47bb75a07faf9030d5f3687adfee3f0ccb3398bf5",
          "sourceTextRef": "354b67c50034",
          "spec": {
            "summary": "每张符合条件的锦囊使用都先结算暴怒/体力选择。",
            "timing": "使用非延时锦囊牌时",
            "condition": "技能有效，牌种为非延时锦囊",
            "cost": "选择弃1暴怒或失去1体力；无暴怒只能失体力",
            "effect": "每张符合条件的锦囊使用都先结算暴怒/体力选择。",
            "frequency": "锁定，无每回合次数上限",
            "engineHooks": [
              "beforeTrickUse"
            ],
            "boundaries": [
              "无懈也是使用锦囊，需覆盖响应链；铁索重铸不是使用，不触发。",
              "延时锦囊不触发；虚拟锦囊按实际使用牌种。",
              "付体力产生濒死可挂起，恢复后不得重复扣成本。",
              "无谋导致吕布死亡后，还未触发的无双不得发动；已锁定的其他牌效果按死亡规则继续。"
            ]
          }
        },
        {
          "localSkillId": "shenfen",
          "name": "神愤",
          "implementationStatus": "implemented",
          "sourceLine": "card__hero__legend.md:65",
          "sourceTextSha256": "b744a1726392b348fe2cf889aa7419b68ab301e1806a6c0d0c42575bd7b650a1",
          "sourceTextRef": "b744a1726392",
          "spec": {
            "summary": "所有其他角色先依次各受1伤害，再依次弃所有装备，再依次弃4手牌，最后自己翻面。",
            "timing": "出牌阶段",
            "condition": "至少6暴怒",
            "cost": "弃6暴怒，消耗本阶段次数",
            "effect": "所有其他角色先依次各受1伤害，再依次弃所有装备，再依次弃4手牌，最后自己翻面。",
            "frequency": "每出牌阶段一次",
            "engineHooks": [
              "onActiveSkill"
            ],
            "boundaries": [
              "不是每个目标伤害/装备/手牌一次做完；全体伤害一轮，再全体装备，再全体手牌。",
              "不足4手牌尽量弃完；新获得牌按当时到达该步骤的状态。",
              "天香、濒死、失装等插入后逐步恢复，不重复目标或阶段。",
              "已支付后的伤害不因临时技能失效取消；死亡/游戏结束沿总规则。"
            ]
          }
        },
        {
          "localSkillId": "wuqian",
          "name": "无前",
          "implementationStatus": "implemented",
          "sourceLine": "card__hero__legend.md:67",
          "sourceTextSha256": "5213d97700ea8a2cbe32a2b604057aa8fcf0a7dc6e9b4ab542814243c710c286",
          "sourceTextRef": "5213d97700ea",
          "spec": {
            "summary": "本回合给自己无双技能并令指定角色防具技能无效。",
            "timing": "出牌阶段",
            "condition": "至少2暴怒且选择一名存活角色",
            "cost": "弃2暴怒",
            "effect": "本回合给自己无双技能并令指定角色防具技能无效。",
            "frequency": "无每阶段次数上限，可多次选不同角色",
            "engineHooks": [
              "onActiveSkill",
              "clearTurnEffects",
              "clearDeathEffects"
            ],
            "boundaries": [
              "文面允许选择自己；同一目标可再次发动但不叠加重复无双响应数。",
              "已有原生无双不得在到期时误删除；用独立临时来源。",
              "防具无效覆盖所有防具技能出口（含视为装备），不是只在自己杀该目标时忽略。",
              "施法者本回合结束或死亡取消持续效果；已触发无双双响应数仍保留。"
            ]
          }
        }
      ]
    },
